            "name": "Delivery Status Label",
            "dataType": "string",
            "expression": "SWITCH (\n    TRUE (),\n    ISBLANK ( powerbi_orders[is_late] ), \"配送信息缺失\",\n    powerbi_orders[is_late] = TRUE (), \"延迟\",\n    \"准时\"\n)"
