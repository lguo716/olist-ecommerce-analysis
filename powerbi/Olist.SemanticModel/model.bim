        ],
        "dataCategory": "Time",
        "lineageTag": "b29e4aff-2e0b-4924-aa15-fe01ec452261",
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "VAR MinDate = MIN ( powerbi_orders[purchase_date] )",
                "VAR MaxDate = MAX ( powerbi_orders[purchase_date] )",
                "RETURN",
                "ADDCOLUMNS (",
                "    CALENDAR ( MinDate, MaxDate ),",
                "    \"Year\", YEAR ( [Date] ),",
                "    \"Month Number\", MONTH ( [Date] ),",
                "    \"Month\", FORMAT ( [Date], \"MMM\" ),",
                "    \"Year Month\", FORMAT ( [Date], \"YYYY-MM\" ),",
                "    \"Year Month Sort\", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),",
                "    \"Quarter\", \"Q\" & FORMAT ( [Date], \"Q\" ),",
                "    \"Is Complete Core Month\",",
                "        [Date] >= DATE ( 2017, 1, 1 )",
                "            && [Date] < DATE ( 2018, 9, 1 )",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "Metrics",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "string",
            "type": "calculatedTableColumn",
            "isHidden": true,
            "sourceColumn": "[Placeholder]"
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE ( \"Placeholder\", STRING, { { \"\" } } )"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT ( powerbi_orders[order_id] )",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivered GMV",
            "expression": "CALCULATE (\n    SUM ( powerbi_orders[item_revenue] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivered Freight",
            "expression": "CALCULATE (\n    SUM ( powerbi_orders[freight_value] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE ( [Delivered GMV], [Delivered Orders] )",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Purchasing Customers",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[customer_unique_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Repeat Customers",
            "expression": "VAR CustomerOrders =\n    ADDCOLUMNS (\n        VALUES ( powerbi_orders[customer_unique_id] ),\n        \"@DeliveredOrders\",\n            CALCULATE (\n                DISTINCTCOUNT ( powerbi_orders[order_id] ),\n                KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n            )\n    )\nRETURN\nCOUNTROWS (\n    FILTER ( CustomerOrders, [@DeliveredOrders] >= 2 )\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Repeat Customer Rate",
            "expression": "DIVIDE ( [Repeat Customers], [Purchasing Customers] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE (\n    CALCULATE (\n        DISTINCTCOUNT ( powerbi_orders[order_id] ),\n        powerbi_orders[order_status] = \"canceled\"\n    ),\n    [Total Orders]\n)",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "On-time Delivered Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" ),\n    NOT ISBLANK ( powerbi_orders[is_late] ),\n    powerbi_orders[is_late] = FALSE ()\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Known Delivery Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" ),\n    NOT ISBLANK ( powerbi_orders[is_late] )\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "On-time Delivery Rate",
            "expression": "DIVIDE ( [On-time Delivered Orders], [Known Delivery Orders] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "Late Delivered Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" ),\n    powerbi_orders[is_late] = TRUE ()\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Late Delivery Rate",
            "expression": "DIVIDE ( [Late Delivered Orders], [Known Delivery Orders] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "Average Delivery Days",
            "expression": "CALCULATE (\n    AVERAGE ( powerbi_orders[delivery_days] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Average Review Score",
            "expression": "CALCULATE (\n    AVERAGE ( powerbi_orders[review_score] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" )\n)",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Low-review Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" ),\n    NOT ISBLANK ( powerbi_orders[review_score] ),\n    powerbi_orders[review_score] <= 2\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Rated Delivered Orders",
            "expression": "CALCULATE (\n    DISTINCTCOUNT ( powerbi_orders[order_id] ),\n    KEEPFILTERS ( powerbi_orders[order_status] = \"delivered\" ),\n    NOT ISBLANK ( powerbi_orders[review_score] )\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Low-review Rate",
            "expression": "DIVIDE ( [Low-review Orders], [Rated Delivered Orders] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "GMV MoM %",
            "expression": "VAR MonthStart = DATE ( YEAR ( MAX ( 'Date'[Date] ) ), MONTH ( MAX ( 'Date'[Date] ) ), 1 )\nVAR PreviousMonthGMV = CALCULATE ( [Delivered GMV], DATEADD ( 'Date'[Date], -1, MONTH ) )\nRETURN\n    IF (\n        HASONEVALUE ( 'Date'[Year Month] )\n            && MonthStart >= DATE ( 2017, 2, 1 )\n            && MonthStart <= DATE ( 2018, 8, 1 ),\n        DIVIDE ( [Delivered GMV] - PreviousMonthGMV, PreviousMonthGMV )\n    )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "Eligible 90D Customers",
            "expression": "CALCULATE (\n    COUNTROWS ( powerbi_customers ),\n    powerbi_customers[eligible_90d] = TRUE ()\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "90D Repeat Customers",
            "expression": "CALCULATE (\n    COUNTROWS ( powerbi_customers ),\n    powerbi_customers[eligible_90d] = TRUE (),\n    powerbi_customers[repeat_within_90d] = TRUE ()\n)",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "90D Repeat Rate",
            "expression": "DIVIDE ( [90D Repeat Customers], [Eligible 90D Customers] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "Item GMV",
            "expression": "CALCULATE (\n    SUM ( powerbi_order_items[price] ),\n    KEEPFILTERS ( powerbi_order_items[order_status] = \"delivered\" )\n)",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Freight to GMV Rate",
            "expression": "DIVIDE ( [Delivered Freight], [Delivered GMV] )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          },
          {
            "name": "RFM Customer Value",
            "expression": "SUM ( powerbi_customers[monetary] )",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Top 10 Item GMV",
            "expression": "IF ( RANKX ( ALLSELECTED ( powerbi_order_items[category] ), [Item GMV], , DESC, DENSE ) <= 10, [Item GMV] )",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "RFM Customers",
            "expression": "COUNTROWS ( powerbi_customers )",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "RFM Value",
            "expression": "SUM ( powerbi_customers[monetary] )",
            "formatString": "#,0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Customer Frequency Count",
            "expression": "COUNTROWS ( powerbi_customers )",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Item Weight Kg",
            "expression": "AVERAGE ( powerbi_order_items[product_weight_g] ) / 1000",
            "formatString": "0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Item Volume Litres",
            "expression": "AVERAGE ( powerbi_order_items[product_volume_cm3] ) / 1000",
            "formatString": "0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Item Freight",
            "expression": "AVERAGE ( powerbi_order_items[freight_value] )",
            "formatString": "0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivery Group Orders",
            "expression": "CALCULATE ( [Delivered Orders], NOT ISBLANK ( powerbi_orders[is_late] ), NOT ISBLANK ( powerbi_orders[review_score] ) )",
            "formatString": "#,0",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivery Group Score",
            "expression": "CALCULATE ( [Average Review Score], NOT ISBLANK ( powerbi_orders[is_late] ) )",
            "formatString": "0.00",
            "displayFolder": "经营分析"
          },
          {
            "name": "Delivery Group Low Rate",
            "expression": "CALCULATE ( [Low-review Rate], NOT ISBLANK ( powerbi_orders[is_late] ) )",
            "formatString": "0.00%",
            "displayFolder": "经营分析"
          }
        ]
      }
    ],
    "valueFilterBehavior": "independent"
  }
}