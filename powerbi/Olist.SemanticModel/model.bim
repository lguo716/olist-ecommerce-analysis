            "displayFolder": "看板度量"
          },
          {
            "name": "Retention Cell Color",
            "expression": "VAR Rate = [Retention]\nRETURN SWITCH ( TRUE (), ISBLANK ( Rate ), BLANK (), SELECTEDVALUE ( cohort_retention_tidy[cohort_index] ) = 0, \"#DBEAFE\", Rate = 0, \"#F8FAFC\", Rate < 0.003, \"#DBEAFE\", Rate < 0.005, \"#93C5FD\", \"#3B82F6\" )",
            "formatString": "",
            "displayFolder": "看板度量"
          }
        ],
